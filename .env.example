# ==========================================
# Configurações da Aplicação
# ==========================================
PORT=3000
API_PREFIX=

FRONTEND_URL=http://localhost:3000

TRUST_PROXY=1

ADMIN_EMAIL=admin@admin.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# ==========================================
# Configurações do Banco de Dados (PostgreSQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=docker
POSTGRES_DB=pelada_draft
DATABASE_URL="postgresql://postgres:docker@localhost:5432/pelada_draft?schema=public"

# ==========================================
# Configurações de Autenticação (JWT)
# ==========================================
ACCESS_TOKEN_SECRET=SECRET_PARA_ACCESS_TOKEN_SUPER_SEGURO
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=SECRET_PARA_REFRESH_TOKEN_MAIS_SEGURO_AINDA
REFRESH_TOKEN_EXPIRES_IN=8d

# ==========================================
# Configurações do Google OAuth 2.0
# ==========================================
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=SEU_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=SEU_GOOGLE_CLIENT_SECRET
# URL que o Google redirecionará após autenticação (deve bater com o configurado no Console)
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
