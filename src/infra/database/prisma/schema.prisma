// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat  = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  ADMIN
  USER
}

enum PeladaPrivilege {
  MANAGE_PLAYERS
  DRAW_TEAMS
}

enum PlayerPosition {
  ZAGA
  MEIO
  ATAQUE
  GERAL
}

model User {
  id          String             @id @default(uuid())
  email       String             @unique
  username    String             @unique
  password    String
  role        GlobalRole         @default(USER)
  ownedPeladas Pelada[]          @relation("PeladaOwner")
  permissions  PeladaPermission[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  refreshTokens UserRefreshToken[]
}

model Pelada {
  id          String             @id @default(uuid())
  name        String
  ownerId     String
  owner       User               @relation("PeladaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  players     Player[]
  permissions PeladaPermission[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model PeladaPermission {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  peladaId  String
  pelada    Pelada          @relation(fields: [peladaId], references: [id], onDelete: Cascade)
  privilege PeladaPrivilege
  createdAt DateTime        @default(now())
  @@unique([userId, peladaId, privilege])
}

model Player {
  id        String   @id @default(uuid())
  name      String
  stars     Int
  position  PlayerPosition   @default(GERAL)
  peladaId  String
  pelada    Pelada   @relation(fields: [peladaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([peladaId, name])
}

model UserRefreshToken {
  id        String   @id @default(uuid())
  tokenJti  String   @unique // O ID único do refresh token gerado
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}